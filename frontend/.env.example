# Only needed if you want to test against a deployed backend from local dev
# (Vite proxies /api to localhost:5000 automatically otherwise — see vite.config.js)
VITE_API_URL=

# Required for "Sign in with Google" button (components/GoogleLoginButton.jsx).
# This is the Client ID only (public, safe to expose in frontend code) —
# never put the Client Secret here or anywhere in frontend code.
VITE_GOOGLE_CLIENT_ID=